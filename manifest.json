{
  "manifest_version": 3,
  "name": "Click to View Media",
  "version": "1.3.1",
  "description": "Hides images (including CSS backgrounds) and videos until you click to reveal them, and silences/skips YouTube ads.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Click to View Media",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}