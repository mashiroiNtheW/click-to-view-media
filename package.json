{
  "name": "click-to-view-media",
  "version": "1.4.0",
  "private": true,
  "description": "Blur images and videos until clicked, with YouTube ad mute/skip. Chrome and Firefox for Android builds.",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir=dist/firefox",
    "package:firefox": "npm run build:firefox && web-ext build --source-dir=dist/firefox --artifacts-dir=web-ext-artifacts --overwrite-dest",
    "run:android": "npm run build:firefox && web-ext run --source-dir=dist/firefox --target=firefox-android --firefox-apk=org.mozilla.firefox_beta"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
